{
  "title": "Komari",
  "config": {
    "step": {
      "user": {
        "title": "Connect to a Komari panel",
        "description": "Enter the panel root URL. You may also paste a URL ending in /api/rpc2.",
        "data": {
          "url": "Panel URL",
          "api_key": "API key",
          "verify_ssl": "Verify TLS certificate"
